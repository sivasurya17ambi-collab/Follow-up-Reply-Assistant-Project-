# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# LLM Provider Configuration (Optional: built-in contextual fallback works 100% offline)
# Supported: "mock" (offline default), "openai", "gemini"
LLM_PROVIDER=mock

# If using OpenAI:
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# If using Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Vector DB & Storage Paths
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=followup_context_collection
TEMPLATE_DIRECTORY=data/templates
HISTORY_FILE=data/history.json

# Security & Access Control
ADMIN_API_KEY=admin_secure_key_prj042
